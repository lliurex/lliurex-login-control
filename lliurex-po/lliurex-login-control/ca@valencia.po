#: ../lliurex-login-control.install/ui/rsrc/ApplicationOptions.qml:24
msgid "Configuration"
msgstr "Configuració"

#: ../lliurex-login-control.install/ui/rsrc/ApplicationOptions.qml:32
msgid "Help"
msgstr "Ajuda"

#: ../lliurex-login-control.install/ui/rsrc/CustomPopup.qml:71
msgid "Apply changes. Wait a moment..."
msgstr "S’estan aplicant els canvis. Espereu un moment..."

#: ../lliurex-login-control.install/ui/rsrc/CustomPopup.qml:73
msgid "Restoring previous values. Wait a moment..."
msgstr "S’estan restaurant els valors anteriors. Espereu un moment..."

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:32
msgid "Login configuration"
msgstr "Configuració del inici de sessió"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:50
msgid "Activate automatic connection to the Wifi (WIFI_EDU) at login"
msgstr ""
"Activar la connexió automàtica a la wifi (WIFI_EDU) en l'inici de sessió"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:65
msgid "Default access mode:"
msgstr "Mode d'accés per defecte:"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:86
#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:96
msgid "Access using user credentials"
msgstr "Accés mitjançant credencials d'usuari"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:107
msgid "Automatic login with alumnat user"
msgstr "Inici automàtic de sessió amb usuari alumnat"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:118
#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:129
msgid "Access using Easy-Login"
msgstr "Accés mitjançant Easy-Login"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:147
msgid "Password for wifi connection with alumnat or Easy-Login:"
msgstr ""
"Contrasenya per a la connexió per Wifi mitjançant alumnat o Easy-Login:"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:154
msgid "Password:"
msgstr "Contrasenya:"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:207
msgid "Click to edit password"
msgstr "Feu clic per a editar la contrasenya"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:208
msgid "Click to cancel password editing"
msgstr "Feu clic per a cancel·lar l'edició de la contrasenya"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:223
msgid "Click to clear password"
msgstr "Feu clic per a esborrar la contrasenya"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:233
msgid "Confirm password:"
msgstr "Confirmar la contrasenya:"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:288
msgid "Activate a guest user account (no network connection if using Wi-Fi)"
msgstr ""
"Activar un compte d'usuari convidat (sense connexió de xarxa si s'usa la "
"Wifi)"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:319
msgid "Apply"
msgstr "Aplica"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:338
#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:357
#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:383
msgid "Cancel"
msgstr "Cancel·la"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:352
msgid ""
"The are pending changes to apply.\n"
"Do you want apply the changes or discard them?"
msgstr ""
"Hi ha canvis pendents d’aplicar.\n"
"Voleu aplicar els canvis o descartar-los?"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:354
msgid "Discard"
msgstr "Descarta"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:378
msgid "Do you want to delete the password for alumnat user?"
msgstr "Voleu esborrar la contrasenya per a l'usuari alumnat?"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:381
#: ../lliurex-login-control.install/ui/rsrc/ChangesDialog.qml:76
msgid "Accept"
msgstr "Accepta"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:400
msgid ""
"It is necessary to activate the integration with Digital Identitiy to be "
"able to log in with WIFI GVA"
msgstr ""
"És necessari activar la integració amb la Identitat Digital per a poder "
"iniciar sessió amb la WIFI GVA"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:403
msgid "Close"
msgstr "Tanca"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:422
msgid "Changes applied successfully"
msgstr "Els canvis s’ha aplicat correctament"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:424
msgid ""
"It is necessary to activate the integration with Digital Identity to be able "
"to log in with WIFI GVA"
msgstr ""
"És necessari activar la integració amb la Identitat Digital per a poder "
"iniciar sessió amb la WIFI GVA"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:426
msgid ""
"The default login option is configured to use Easy-Login but its activation "
"has failed"
msgstr ""
"El mode d'accés per defecte esta configurat per a usar Easy-Login però la "
"seua activació ha fallat"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:428
msgid ""
"The default login option is configured to use Auto-Login but its activation "
"has failed"
msgstr ""
"El mode d'accés per defecte esta configurat per a usar Auto-Login però la "
"seua activació ha fallat"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:430
msgid "Error reloading configuration"
msgstr "S’ha produït un error recarregant la configuració"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:432
msgid "Error changing login settings"
msgstr "S’ha produït un error canviant la configuració d'inici de sessió"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:434
msgid "Error activating Auto-Login"
msgstr "S’ha produït un error activant Easy-Login"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:436
msgid "The Auto-Login setting could not be disabled"
msgstr "La configuració de Auto-Login no ha pogut ser desactivada"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:438
msgid "Error activating Easy-Login"
msgstr "S’ha produït un error desactivant Easy-Login"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:440
msgid "The Easy-Login setting could not be disabled"
msgstr "La configuració de Easy-Login no ha pogut ser desactivada"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:442
msgid "Error changing guest user activation"
msgstr ""
"S’ha produït un error canviant l'activació del compte d'usuari convidat"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:444
msgid "Multiple errors have ocurred while applying changes"
msgstr "S'han produït diversos errors en aplicar els canvis"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:446
msgid "Passwords must match"
msgstr "Les contrasenyes han de coincidir"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:448
msgid "You must enter a password"
msgstr "Introduïu una contrasenya"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:450
msgid "Error changing password for Auto-Login or Easy-Login"
msgstr ""
"S’ha produït un error canviant la contrasenya per a Auto-Login o Easy-Login"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:506
msgid "Click to show password"
msgstr "Feu clic per a mostrar la contrasenya"

#: ../lliurex-login-control.install/ui/rsrc/LoginOptions.qml:507
msgid "Click to hide password"
msgstr "Feu clic per a ocultar la contrasenya"

#: ../lliurex-login-control.install/ui/rsrc/Loading.qml:60
msgid "Loading. Wait a moment..."
msgstr "S’està carregant. Espereu un moment..."

#: ../lliurex-login-control.install/ui/rsrc/Loading.qml:71
msgid "Error loading configuration"
msgstr "S’ha produït un error carregant la configuració"
